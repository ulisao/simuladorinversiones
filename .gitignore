# Python
backend/venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Base de datos local
backend/*.db

# Credenciales — archivos .env (Tarea 8.3)
# Se ignora cualquier .env en cualquier carpeta, salvo los .example que SÍ se
# versionan (son la plantilla sin valores).
.env
.env.*
**/.env
**/.env.*
# El patrón cubre .env.example y también .env.local.example: con la negación
# antigua (`!**/.env.example` a secas) la plantilla del frontend quedaba ignorada
# y nunca llegaba al repo, aunque el README la mencionara.
!.env*.example
!**/.env*.example
backend/.env
credenciales_google.json

# Claves privadas y certificados (Tarea 8.3)
# Una clave privada commiteada es prácticamente imposible de sacar del historial
# después: se bloquea por patrón, no por nombre puntual.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.asc
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.key.pub
ssh-key-*
.ssh/
# Credenciales de nubes / servicios
*service-account*.json
*credentials*.json
.aws/
.netrc
_netrc

# Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Sistema
.DS_Store
Thumbs.db
backend/data/

# El .env.local del frontend llegó a estar versionado por error (commit `base`).
# Trae NEXT_PUBLIC_API_KEY, que es una credencial. La plantilla sin valores es
# frontend/.env.local.example.
frontend/.env.local
# Artefacto de build de TypeScript, no va al repo.
frontend/tsconfig.tsbuildinfo
