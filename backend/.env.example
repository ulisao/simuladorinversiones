# Copiar a backend/.env y completar. NUNCA commitear el .env con valores reales.

# ---------- InvertirOnline (IOL) ----------
IOL_USERNAME=
IOL_PASSWORD=
IOL_API_URL=https://api.invertironline.com

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Capital y riesgo (opcional: pisan los defaults de app/config.py) ----------
# Los valores acordados están en docs/parametros-riesgo.md. Solo hace falta
# ponerlos acá si se quiere correr con otros sin tocar el código.
CAPITAL_TOTAL=100000
MAX_POSICIONES=2
# Cupo de capital de cada estrategia. Tienen que sumar 1.0.
CUPO_SWING=0.40
CUPO_SMART_MONEY=0.60
# Máximo del cupo de una estrategia que puede ir a un solo activo.
LIMITE_POR_OPERACION=0.50
# Piso de saldo por debajo del cual no se abren posiciones nuevas.
SALDO_MINIMO_OPERAR=10000

# ---------- SEC EDGAR (consenso institucional 13F, Tarea 5.3) ----------
# La API pública de SEC rechaza pedidos sin un User-Agent que identifique a
# quien consulta. No es una credencial: es un dato de contacto.
SEC_USER_AGENT="Simulador Inversiones IA (contacto: tu-email@ejemplo.com)"

# ---------- Autenticación de la API ----------
# La API expone el saldo real de la cuenta comitente y permite crear y borrar
# operaciones: sin clave, cualquiera que llegue al puerto puede hacerlo.
#
# Falla cerrada: SIN API_KEY la API responde 503 a todo salvo /health. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Escotilla de emergencia. En true la API atiende sin pedir clave — solo tiene
# sentido si escucha en 127.0.0.1. Nunca en una API expuesta a internet.
API_AUTH_DESHABILITADA=false

# Orígenes que el navegador puede usar para llamar a la API (lista por comas).
# Antes era "*"; el default de ahora es el frontend corriendo en local.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Google Sheets como bitácora espejo (Fase 6, OPCIONAL) ----------
# Solo hace falta si querés espejar las operaciones cerradas a la hoja
# `Trading_Log_IOL` para mirarlas desde el celular. Sin esto la app funciona
# igual y el botón "Sincronizar con Sheets" queda deshabilitado.
# El JSON sale de la Tarea 0.4 (cuenta de servicio de Google Cloud) y NUNCA se
# commitea: .gitignore ya bloquea credenciales_google.json.
GOOGLE_CREDENTIALS_PATH=
SHEETS_NOMBRE_HOJA=Trading_Log_IOL

# ---------- Kill switch de ejecución real ----------
# En true (el default) el sistema genera, notifica y registra igual que si
# operara, pero NUNCA llama a la API de IOL. Recién en false opera de verdad.
# Reemplaza a la vieja EJECUCION_REAL_HABILITADA, que ya no se lee.
MODO_FANTASMA=true
