# Copiar a frontend/.env.local y completar. NO commitear el .env.local.
#
# OJO con el prefijo: una variable NEXT_PUBLIC_ queda incrustada en el bundle
# que se descarga el navegador. NINGUNA de las de abajo lo lleva, y no hay que
# agregárselo: todas son secretos que viven del lado del servidor de Next.

# ---------- A dónde le pega el proxy (app/api/backend/[...path]/route.ts) ----------
# En local, o por túnel SSH contra el VPS:
#   ssh -i ~/.ssh/tradingbot.key -L 8123:127.0.0.1:8123 ubuntu@<ip-del-vps>
# En Vercel: el hostname HTTPS que publica el túnel de Cloudflare
#   (ver deploy/cloudflared.service), por ejemplo https://api.tu-dominio.com
BACKEND_URL=http://127.0.0.1:8123

# Tiene que ser EXACTAMENTE la misma que API_KEY de backend/.env.
BACKEND_API_KEY=

# ---------- Puerta de entrada del dashboard (proxy.ts) ----------
# Publicado en internet, el frontend expone el saldo real de la cuenta comitente
# y el borrado de operaciones. Sin estas dos variables el deploy responde 503 a
# todo: falla cerrada, igual que la API sin API_KEY.
#
# Generarlas con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_PASSWORD=
SESSION_SECRET=
